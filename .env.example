# Supabase (בלי אלה האתר רץ על נתוני דמו)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ספק סטטיסטיקה
BALLDONTLIE_API_KEY=
DENI_PLAYER_ID=            # מזהה דני אצל BALLDONTLIE — למלא אחרי חיפוש /players?search=avdija

# וידאו
YOUTUBE_API_KEY=

# תקצירים בעברית
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# הגנה על נקודות ה-cron (Vercel שולח Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# true = תקצירים עולים מיד; false = ממתינים לאישור עורך
AUTO_PUBLISH_RECAPS=false
